# ============================================
# MERN CTF PLATFORM - BACKEND ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control

# ============================================
# Database Configuration
# ============================================
# MongoDB connection URI (use MongoDB Atlas for production)
# The server accepts both MONGO_URI and MONGODB_URI for backward compatibility.
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/ctf-platform?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/ctf-platform?retryWrites=true&w=majority

# ============================================
# JWT Configuration
# ============================================
# Secret key for signing JWT tokens (use a long, random string)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Token expiration time (example: 7 days)
JWT_EXPIRES_IN=7d

# ============================================
# Server Configuration
# ============================================
# Server port
PORT=5000

# Node environment (development, production, test)
NODE_ENV=production

# ============================================
# CORS Configuration
# ============================================
# Frontend URL for CORS (set to your deployed frontend domain)
# CRITICAL for production: Frontend and backend are on different domains
# Examples:
#   For Vercel: https://your-app.vercel.app (or custom domain)
#   For Netlify: https://your-app.netlify.app
#   For custom domain: https://yourdomain.com
# NOTE: Do NOT include /api prefix - just the domain
FRONTEND_URL=https://cyber-ctf-beta.vercel.app

# Optional legacy fallback (prefer FRONTEND_URL)
CORS_ORIGIN=https://cyber-ctf-beta.vercel.app

# ============================================
# Admin Registration Security
# ============================================
# Secret token required to create admin accounts
# Generate with: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
ADMIN_REGISTRATION_TOKEN=your-secure-admin-token-change-this

# ============================================
# Security Settings
# ============================================
# Password hashing rounds (10-12 recommended)
BCRYPT_ROUNDS=10

# ============================================
# Logging
# ============================================
# Log level: debug, info, warn, error
LOG_LEVEL=info

# ============================================
# Transactional Email (Resend)
# ============================================
# Resend API Key for sending participant login credentials
# Obtain from https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here

# Verified sender address (e.g., onboarding@resend.dev or ctf@yourdomain.com)
EMAIL_FROM="FlagHunters CTF <onboarding@resend.dev>"
