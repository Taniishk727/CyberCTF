# =============================================================================
# FlagHunters CTF — Backend Environment Variables
# =============================================================================

# Server & Network
PORT=5000
NODE_ENV=production
FRONTEND_URL=https://flaghunters-two.vercel.app
# Used for Gmail OAuth callback success/error redirects; CORS origins are maintained in server.js.

# Database (MongoDB Atlas)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/cyberctf?retryWrites=true&w=majority

# Authentication
JWT_SECRET=generate-a-secure-random-string-at-least-32-characters

# Cloudinary challenge attachment uploads (backend-only; never use VITE_ prefix)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# =============================================================================
# Gmail API OAuth 2.0 Integration (SOLE TRANSACTIONAL EMAIL PROVIDER)
# Replaces Resend. Participant credential emails are dispatched through the official
# competition Gmail account authorized by an administrator via OAuth 2.0.
# =============================================================================

# 1. OAuth Client ID from Google Cloud Console (APIs & Services > Credentials)
GMAIL_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# 2. OAuth Client Secret from Google Cloud Console
GMAIL_CLIENT_SECRET=your-google-oauth-client-secret

# 3. Exact Authorized Redirect URI registered in Google Cloud Console
# Must match the URL in Google Cloud Console OAuth Client configuration exactly:
GMAIL_REDIRECT_URI=https://cyberctf-rg8k.onrender.com/api/email/oauth/callback
# This exact callback URL must also be listed as an Authorized redirect URI in Google Cloud Console.

# 4. AES-256-GCM Token Encryption Key (Backend-only)
# Used to encrypt the OAuth refresh token at rest in MongoDB.
# Generate a fresh 32-byte key using:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GMAIL_TOKEN_ENCRYPTION_KEY=your-base64-encoded-32-byte-encryption-key

# =============================================================================
# Legacy Email Provider (DEPRECATED — NO LONGER REQUIRED)
# =============================================================================
# RESEND_API_KEY=   # (No longer required - migration to Gmail API complete)
# EMAIL_FROM=       # (No longer required - sender address is obtained from authorized Gmail account)
