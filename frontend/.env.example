# ============================================
# Frontend Environment Variables
# ============================================
# Copy this file to .env and fill in your actual values

# ============================================
# API Configuration
# ============================================
# Production: Backend API URL from your deployment (Render, Heroku, etc.)
# Should be set BOTH here AND in Vercel project dashboard
# IMPORTANT: VITE_ prefix makes it available in browser code
# Examples:
#   For Render: https://your-app.onrender.com/api
#   For Vercel API routes: https://your-app.vercel.app/api
#   For custom domain: https://api.yourdomain.com/api
VITE_API_URL=https://cyberctf.onrender.com/api

# Development: Proxy target for Vite dev server
# When running `npm run dev` locally, requests to /api are proxied here
# Do NOT use in production - only for local development
VITE_API_PROXY=http://127.0.0.1:5000

# ============================================
# Media Configuration (Cloudinary)
# ============================================
# Used for uploading challenges images, avatars, etc.
# Get these from your Cloudinary dashboard:
# Dashboard → Settings → Cloud Name
## Challenge attachments use the authenticated backend Cloudinary configuration.

# Upload preset for unauthenticated uploads
# Dashboard → Settings → Upload → Upload presets
